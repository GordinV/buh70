# Gemini API Key и Модель (от Google AI Studio или Google Cloud Vertex AI)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Базовый URL бэкенда buh70
BUH70_API_BASE_URL=http://localhost:3000

# Bearer токен авторизации для сервисных вызовов
BUH70_API_TOKEN=mock_buh70_token

# Дефолтные параметры для регламентных запусков
DEFAULT_USER_ID=2477
DEFAULT_REKV_ID=63
DEFAULT_KOND=1

# Интервал опроса логов (в миллисекундах) - по умолчанию 60 сек (1 минута)
TASK_POLL_INTERVAL_MS=60000

# Максимальный таймаут ожидания завершения фоновой задачи (4 часа = 14 400 000 мс)
TASK_TIMEOUT_MS=14400000

# Путь к файлу памяти состояния и час суточного расчетного окна (по умолчанию 20:00)
STATE_FILE_PATH=./state/orchestrator_state.json
DAILY_START_HOUR=20

# Настройки отправки отчетов по электронной почте (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=vladislav.gordin@gmail.com
SMTP_PASS=motxuaixerasoore
REPORT_EMAIL_FROM="buh70 AI Orchestrator" <vladislav.gordin@gmail.com>
REPORT_EMAIL_TO=vladislav.gordin@bs2.ee
